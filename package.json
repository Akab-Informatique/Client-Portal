{
  "name": "akab-portal",
  "private": true,
  "version": "1.0.0",
  "description": "AKAB client portal — tickets (Autotask), documentation (SharePoint/Graph), messaging, multi-tenant zones",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --import tsx server/prod-server.mjs",
    "typecheck": "tsc -b --pretty false",
    "db:status": "curl -s http://127.0.0.1:${PORT:-3000}/api/db/status?migrate=1 | python3 -m json.tool || curl -s http://127.0.0.1:${PORT:-3000}/api/db/status?migrate=1",
    "backup": "bash scripts/backup-db.sh",
    "upgrade": "bash scripts/upgrade.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@radix-ui/react-icons": "^1.3.2",
    "@vercel/node": "^3.2.29",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^1.7.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
