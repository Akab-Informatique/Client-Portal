{
  "name": "akab-portal",
  "private": true,
  "version": "2.0.0",
  "description": "AKAB Portal — internal team and client portal for AKAB Informatique",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch-path=server --watch-path=shared --watch-preserve-output --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.server.json --pretty false",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nodemailer": "^10.0.16",
    "openpgp": "^6.3.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
