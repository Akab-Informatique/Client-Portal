# =============================================================================
# AKAB Portal — environment file
#   cp .env.example .env   → fill in the REQUIRED block → see INSTALL.md
# NEVER commit .env to git. Back it up: it holds the DB password and the
# encryption key for stored integration secrets.
# Rules: no spaces around "="; values containing $ or # go in 'single quotes'.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------
POSTGRES_DB=akab
POSTGRES_USER=akab
# openssl rand -hex 16 — never change it after the first start
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32 — the placeholder is refused (no login possible)
SESSION_SECRET=change-me
# openssl rand -hex 32 — encrypts stored integration secrets; keep a backup
CREDENTIALS_ENCRYPTION_KEY=change-me
# Public HTTPS address of the portal (email links + request origin check)
PUBLIC_URL=https://portail.akab.ca
# The web app loads its data through the secured SQL proxy — keep at 1
SQL_PROXY_ENABLED=1

# -----------------------------------------------------------------------------
# NETWORK (your HTTPS reverse proxy forwards to http://<server IP>:3000)
# -----------------------------------------------------------------------------
# Host port or IP:port Docker publishes (default 3000 on all interfaces)
APP_PUBLISH=3000
# Recommended: the reverse proxy's IP. When set, ONLY that IP (and the server
# itself) may connect, and only its X-Forwarded-For is trusted. Comma-separated.
# TRUSTED_PROXY_IPS=192.168.1.10
# Secure cookies are ON (correct behind HTTPS). Plain-HTTP test only: false
# COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# ADVANCED (leave as is with Docker Compose)
# -----------------------------------------------------------------------------
# Compose sets POSTGRES_HOST=db automatically. Only for a host-installed Postgres:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSL=false
# Do NOT set DATABASE_URL with docker compose.
# Production first boot: fixed initial admin password instead of a random one
# BOOTSTRAP_ADMIN_PASSWORD=
# Emergency kill-switch: refuse all browser SQL (the portal UI stops working)
# SQL_PROXY_DISABLED=1
# NEVER put secrets in VITE_* variables — they are shipped to the browser.

# -----------------------------------------------------------------------------
# Autotask PSA (tickets, companies)
# Create: Autotask → Admin → Resources → New → New API User
# Security level: API User (API-only) with CRM → Contacts View + Service Desk Tickets View
# Credentials tab: Generate Username (Key) + Secret + API Tracking Identifier
# -----------------------------------------------------------------------------
# API Tracking Identifier (not the resource email)
AUTOTASK_INTEGRATION_CODE=
# Generated API Username (Key) — NOT a normal Autotask login
AUTOTASK_USERNAME=
# Generated Secret — ALWAYS single-quote (Docker Compose expands $ and # truncates unquoted values)
# Example: AUTOTASK_SECRET='AbC$123#xyz'
AUTOTASK_SECRET=
# Optional: pin zone URL if auto-discovery fails
# Example: https://webservices3.autotask.net/atservicesrest/
# AUTOTASK_ZONE_URL=


# -----------------------------------------------------------------------------
# Microsoft Graph / SharePoint (documentation browser)
# Azure Entra app registration — Application permission Sites.Read.All + admin consent
# Each client can also store their own Tenant / Client ID / Secret under Clients → Edit
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Runtime (self-host / Node server only)
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# -----------------------------------------------------------------------------
# IT Glue / MyGlue (password vault)
# API key must have "Password Access" enabled.
# Region: us (default) | eu | au
# -----------------------------------------------------------------------------
ITGLUE_API_KEY=
ITGLUE_REGION=us

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# SMTP (message board emails)
# Board emails are sent ONE recipient at a time (private To — never a group list).
# Only users with board_email_opt_in receive them when staff checks “Also send by email”.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true / 1 for port 465 (implicit TLS); leave false/empty for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AKAB Portal
# Optional reply-to and silent ops archive (BCC only — never shared with clients)
# SMTP_REPLY_TO=
# SMTP_ARCHIVE_BCC=

# -----------------------------------------------------------------------------
# Datto RMM (devices inventory under Operations → Devices)
# Setup → Global Settings → Access Control → enable API Access
# Setup → Users → Generate API Keys (copy Key, Secret, and API URL once)
# Link each client company to a Site UID under Clients → Edit
# -----------------------------------------------------------------------------
# Example API URL: https://merlot-api.centrastage.net  (no trailing /api)
DATTO_RMM_API_URL=
DATTO_RMM_API_KEY=
# Always single-quote if the secret contains $ or #
# DATTO_RMM_API_SECRET='your-secret'
DATTO_RMM_API_SECRET=
# Optional — web portal base for Web Remote deep links (auto-derived as https://{platform}.rmm.datto.com)
# Example: https://merlot.rmm.datto.com
# DATTO_RMM_PORTAL_URL=
# Optional — force classic URL path: /csm/remote/rto/{uid}  (default is modern /web-remote/{uid})
# DATTO_RMM_WEB_REMOTE_STYLE=classic

# -----------------------------------------------------------------------------
# Splashtop SOS (Open API — attended support session)
# Client clicks SOS → portal creates session → opens support_portal_link
# Client runs SOS app from that link (NO code to type or share)
# Tech sees queue → Connect opens Splashtop Business with the session code
#
# Create token: my.splashtop.com → Account → Web API Tokens (scope: psa, users)
# Docs: https://support-splashtopbusiness.splashtop.com/hc/en-us/articles/16772899906459-Splashtop-Open-APIs
# -----------------------------------------------------------------------------
# Required — raw token, no nested quotes. Scope must include: psa
# Create: my.splashtop.com → Account → Web API Tokens (Owner / Super Admin)
SPLASHTOP_API_TOKEN=
# Optional — leave EMPTY to auto-detect from token (scopes.psa.team_id).
# A wrong pin causes create failures (40404 / 40403). Prefer auto-detect.
# SPLASHTOP_TEAM_ID=
# Optional — default https://webapi.splashtop.com  (EU: https://webapi.splashtop.eu)
# SPLASHTOP_BASE_URL=https://webapi.splashtop.com
# Optional channel — leave EMPTY to auto-use the team Default channel
# (your tenant: Default = 4673). Set 0 for private, or a specific id to pin.
# SPLASHTOP_CHANNEL_ID=
# SPLASHTOP_CHANNEL_ID=4673
# SPLASHTOP_CHANNEL_ID=0
# Optional client launch-link host (default my.splashtop.com / my.splashtop.eu from BASE_URL)
# Only set if your stack uses a custom host (e.g. https://my.aws-rd.splashtop.com)
# SPLASHTOP_PORTAL_BASE_URL=https://my.splashtop.com
#
# --- SOS client download (Default-channel session link ONLY) ---
# Clients always get the API session support_portal_link created on the
# Default channel. Backup package / share / Win-Mac URLs are NOT used.
# Optional display name on the branded download page:
# SPLASHTOP_SOS_PACKAGE_NAME=SOLU TI Remote Support
# Auto-start download on the branded page (default true)
# SPLASHTOP_SOS_AUTO_DOWNLOAD=true
# (Optional brand on the session link itself, in Splashtop console:)
# my.splashtop.com → Management → Settings → Third Party Integration → Package file
