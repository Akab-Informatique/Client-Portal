# =============================================================================
# AKAB Portal — environment file
#   cp .env.example .env   → fill the REQUIRED block → docker compose up -d --build
# Never commit .env. Keep a backup: it holds the database password and the
# key that encrypts MFA secrets.
# Rules: no spaces around "="; values containing $ or # go in 'single quotes'.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------
POSTGRES_DB=akab
POSTGRES_USER=akab
# openssl rand -hex 16 — never change it after the first start
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32 — encrypts MFA secrets; changing it forces everyone to redo MFA
APP_SECRET=change-me
# Public HTTPS address (email links, request origin check)
PUBLIC_URL=https://portail.akab.ca
# First administrator (created on the very first start only)
ADMIN_EMAIL=admin@akab.ca
ADMIN_NAME=Administrateur AKAB
# Leave empty: a one-time password is printed in `docker compose logs app`
# and must be changed at first sign-in.
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# NETWORK (your HTTPS reverse proxy forwards to http://<server IP>:3000)
# -----------------------------------------------------------------------------
# Host port or IP:port Docker publishes (default 3000 on all interfaces)
APP_PUBLISH=3000
# Recommended: your reverse proxy's IP — its X-Forwarded-For is then trusted
# for rate limiting (otherwise every visitor looks like the proxy).
# TRUSTED_PROXY_IPS=192.168.1.10

# -----------------------------------------------------------------------------
# EMAIL (message board copies) — leave SMTP_HOST empty to disable sending
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=AKAB Informatique

# -----------------------------------------------------------------------------
# OPTIONS
# -----------------------------------------------------------------------------
# MFA (authenticator app) is required for everyone. Only for tests: false
# REQUIRE_MFA=true
# Secure cookies are on in production (HTTPS). Plain-HTTP test only: false
# COOKIE_SECURE=true
