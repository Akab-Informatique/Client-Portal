# =============================================================================
# AKAB Portal — environment variables (v1)
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Autotask PSA (tickets, companies)
# From Autotask → Admin → API User (system) security level + API tracking ID
# -----------------------------------------------------------------------------
AUTOTASK_INTEGRATION_CODE=
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
# Optional: pin zone URL if auto-discovery fails (e.g. https://webservicesX.autotask.net/atservicesrest/)
# AUTOTASK_ZONE_URL=

# -----------------------------------------------------------------------------
# Microsoft Graph / SharePoint (documentation browser)
# Azure Entra app registration — Application permission Sites.Read.All + admin consent
# Each client can also store their own Tenant / Client ID / Secret under Clients → Edit
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Runtime (self-host / Node server only)
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# -----------------------------------------------------------------------------
# IT Glue / MyGlue (password vault)
# API key must have "Password Access" enabled.
# Region: us (default) | eu | au
# -----------------------------------------------------------------------------
ITGLUE_API_KEY=
ITGLUE_REGION=us

# -----------------------------------------------------------------------------
# SMTP (message board emails)
# Board emails are sent ONE recipient at a time (private To — never a group list).
# Only users with board_email_opt_in receive them when staff checks “Also send by email”.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true / 1 for port 465 (implicit TLS); leave false/empty for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AKAB Portal
# Optional reply-to and silent ops archive (BCC only — never shared with clients)
# SMTP_REPLY_TO=
# SMTP_ARCHIVE_BCC=
