# =============================================================================
# AKAB Portal — environment variables (v1)
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (REQUIRED for multi-user production)
# With Docker Compose these are used by the db service + app.
# Data lives in Docker volume "akab_pgdata" — survives upgrades.
# -----------------------------------------------------------------------------
POSTGRES_DB=akab
POSTGRES_USER=akab
# REQUIRED. Prefer letters + numbers only (easiest on Docker Compose).
# If you must use $, write $$ in this file.
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Docker Compose overrides these automatically (POSTGRES_HOST=db).
# Only set them for a host-installed Postgres (no Compose db service):
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSL=false

# Do NOT set DATABASE_URL when using docker compose — discrete POSTGRES_* is safer.
# DATABASE_URL=postgres://akab:change-me@127.0.0.1:5432/akab

# Optional shared secret for browser→server SQL proxy on public internet
# DB_PROXY_SECRET=
# VITE_DB_PROXY_SECRET=

# Force browser DB mode in dev only: postgres | pglite
# VITE_DATABASE_MODE=

# -----------------------------------------------------------------------------
# Autotask PSA (tickets, companies)
# Create: Autotask → Admin → Resources → New → New API User
# Security level: API User (API-only) with CRM → Contacts View + Service Desk Tickets View
# Credentials tab: Generate Username (Key) + Secret + API Tracking Identifier
# -----------------------------------------------------------------------------
# API Tracking Identifier (not the resource email)
AUTOTASK_INTEGRATION_CODE=
# Generated API Username (Key) — NOT a normal Autotask login
AUTOTASK_USERNAME=
# Generated Secret — quote if it contains $ # spaces or !
AUTOTASK_SECRET=
# Optional: pin zone URL if auto-discovery fails
# Example: https://webservices3.autotask.net/atservicesrest/
# AUTOTASK_ZONE_URL=

# -----------------------------------------------------------------------------
# Microsoft Graph / SharePoint (documentation browser)
# Azure Entra app registration — Application permission Sites.Read.All + admin consent
# Each client can also store their own Tenant / Client ID / Secret under Clients → Edit
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Runtime (self-host / Node server only)
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# -----------------------------------------------------------------------------
# IT Glue / MyGlue (password vault)
# API key must have "Password Access" enabled.
# Region: us (default) | eu | au
# -----------------------------------------------------------------------------
ITGLUE_API_KEY=
ITGLUE_REGION=us

# -----------------------------------------------------------------------------
# SMTP (message board emails)
# Board emails are sent ONE recipient at a time (private To — never a group list).
# Only users with board_email_opt_in receive them when staff checks “Also send by email”.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true / 1 for port 465 (implicit TLS); leave false/empty for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AKAB Portal
# Optional reply-to and silent ops archive (BCC only — never shared with clients)
# SMTP_REPLY_TO=
# SMTP_ARCHIVE_BCC=
